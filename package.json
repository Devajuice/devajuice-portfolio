{
  "name": "devajith-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "format": "prettier --write src/**/*.{js,jsx,css}",
    "check": "vite build && vite-node scripts/render-check.jsx",
    "render-check": "vite-node scripts/render-check.jsx",
    "browser-check": "node scripts/browser-check.mjs",
    "music-pill-check": "node scripts/music-pill-check.mjs",
    "music-style-check": "node scripts/music-style-check.mjs",
    "ui-polish-check": "node scripts/ui-polish-check.mjs",
    "dev:clean": "node -e \"require('node:fs').rmSync('node_modules/.vite',{recursive:true,force:true})\" && vite"
  },
  "dependencies": {
    "@vercel/og": "^0.10.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^5.0.0",
    "vite-node": "^6.0.0"
  }
}
